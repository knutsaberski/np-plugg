{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["data/**"] }
    },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "style.css",  "use": "@vercel/static" },
    { "src": "app.js",     "use": "@vercel/static" },
    { "src": "pitch.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/",         "dest": "/index.html" },
    { "src": "/(.*)",     "dest": "/$1" }
  ]
}
